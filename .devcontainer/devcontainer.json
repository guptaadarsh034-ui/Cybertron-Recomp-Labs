{
  "name": "Cybertron Recomp Labs",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/cmake:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.unittestEnabled": true,
        "python.testing.pytestEnabled": false,
        "editor.formatOnSave": true
      }
    }
  },
  "postCreateCommand": "python -m unittest discover -s tests -v && cmake -S runtime/ppc -B build/ppc && cmake --build build/ppc --parallel && ./build/ppc/ppc_smoke_test && bash .devcontainer/setup-android.sh"
}
